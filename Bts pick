<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BTS Photo Gallery</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0f0f14;
      color: white;
      min-height: 100vh;
    }

    header {
      text-align: center;
      padding: 50px 20px 25px;
    }

    header h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    header p {
      color: #bdbdc7;
      font-size: 16px;
    }

    .photo-container {
      width: min(900px, 92%);
      margin: 30px auto 60px;
      background: #191922;
      padding: 18px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    }

    .photo-container a {
      display: block;
    }

    .photo-container img {
      display: block;
      width: 100%;
      max-height: 75vh;
      object-fit: contain;
      border-radius: 14px;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .photo-container img:hover {
      transform: scale(1.015);
    }

    .caption {
      text-align: center;
      padding: 18px 10px 8px;
    }

    .caption h2 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .caption p {
      color: #aaaab5;
      font-size: 14px;
    }

    .button {
      display: inline-block;
      margin-top: 18px;
      padding: 12px 22px;
      background: white;
      color: #111;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
      transition: 0.3s;
    }

    .button:hover {
      transform: translateY(-2px);
      opacity: 0.85;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #777783;
      font-size: 13px;
    }
  </style>
</head>

<body>

  <header>
    <h1>📸 BTS Photo Gallery</h1>
    <p>আমার পছন্দের একটি ছবি</p>
  </header>

  <main>
    <div class="photo-container">

      <a
        href="https://raw.githubusercontent.com/litanahosanemo-debug/BTS-Photos/main/IMG-20260715-WA0128.jpg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="https://raw.githubusercontent.com/litanahosanemo-debug/BTS-Photos/main/IMG-20260715-WA0128.jpg"
          alt="BTS Photo"
        >
      </a>

      <div class="caption">
        <h2>BTS Photo</h2>
        <p>ছবির ওপর ক্লিক করলে full-size ছবি খুলবে।</p>

        <a
          class="button"
          href="https://raw.githubusercontent.com/litanahosanemo-debug/BTS-Photos/main/IMG-20260715-WA0128.jpg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Full Size Photo
        </a>
      </div>

    </div>
  </main>

  <footer>
    © 2026 BTS Photo Gallery
  </footer>

</body>
</html>
