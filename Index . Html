<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fanboy Rohan 💜</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #12001f, #3b1266, #16001f);
      color: white;
      min-height: 100vh;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 8%;
      background: rgba(0,0,0,0.35);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
      color: #e6b3ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-weight: bold;
    }

    nav a:hover {
      color: #e6b3ff;
    }

    .hero {
      text-align: center;
      padding: 100px 20px;
    }

    .hero h1 {
      font-size: 55px;
      margin-bottom: 15px;
      color: #f0caff;
    }

    .hero p {
      font-size: 20px;
      margin-bottom: 30px;
      color: #ddd;
    }

    .btn {
      display: inline-block;
      padding: 13px 25px;
      border-radius: 30px;
      background: #9b4dff;
      color: white;
      text-decoration: none;
      font-weight: bold;
      margin: 5px;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      background: #c477ff;
      transform: scale(1.05);
    }

    section {
      padding: 70px 8%;
      text-align: center;
    }

    section h2 {
      font-size: 35px;
      margin-bottom: 25px;
      color: #e5b7ff;
    }

    .card-container {
      display: flex;
      justify-content: center;
      gap: 25px;
      flex-wrap: wrap;
    }

    .card {
      width: 280px;
      padding: 30px;
      border-radius: 20px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
    }

    .card h3 {
      margin-bottom: 15px;
      color: #e9c4ff;
    }

    .profile {
      max-width: 500px;
      margin: auto;
      padding: 35px;
      border-radius: 25px;
      background: rgba(255,255,255,0.08);
    }

    .profile-circle {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      margin: 0 auto 20px;
      background: linear-gradient(135deg,#9b4dff,#e0a3ff);
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 45px;
    }

    form {
      max-width: 400px;
      margin: auto;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    input {
      padding: 14px;
      border-radius: 10px;
      border: none;
      outline: none;
      font-size: 16px;
    }

    footer {
      text-align: center;
      padding: 30px;
      background: rgba(0,0,0,0.4);
      color: #ccc;
    }

    @media (max-width: 700px) {
      .hero h1 {
        font-size: 40px;
      }

      nav {
        flex-direction: column;
        gap: 12px;
      }

      nav a {
        margin: 5px;
      }
    }
  </style>
</head>

<body>

  <!-- Navigation -->
  <nav>
    <div class="logo">💜 Fanboy Rohan</div>

    <div>
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#profile">Profile</a>
      <a href="#login">Login</a>
    </div>
  </nav>

  <!-- Home -->
  <section class="hero" id="home">
    <h1>💜 Fanboy Rohan</h1>

    <p>
      Welcome to my little world ✨<br>
      BTS • ARMY • Music • Memories
    </p>

    <a href="#about" class="btn">Explore 💜</a>
    <a href="#profile" class="btn">My Profile</a>
  </section>

  <!-- About -->
  <section id="about">
    <h2>About Me 👑</h2>

    <div class="card-container">

      <div class="card">
        <h3>💜 My Name</h3>
        <p>Fanboy Rohan</p>
      </div>

      <div class="card">
        <h3>🎵 My Passion</h3>
        <p>BTS, Music & Creating Content</p>
      </div>

      <div class="card">
        <h3>🌍 My Community</h3>
        <p>ARMY Family 💜</p>
      </div>

    </div>
  </section>

  <!-- Profile -->
  <section id="profile">
    <h2>My Profile 👤</h2>

    <div class="profile">

      <div class="profile-circle">
        💜
      </div>

      <h2>Fanboy Rohan</h2>

      <p>
        BTS Lover Boy 💜<br>
        Welcome to my website!
      </p>

      <br>

      <button class="btn" onclick="showMessage()">
        Follow 💜
      </button>

    </div>
  </section>

  <!-- Login / Signup -->
  <section id="login">
    <h2>Login / Signup 🔐</h2>

    <form onsubmit="loginUser(event)">

      <input
        type="text"
        id="name"
        placeholder="Your Name"
        required
      >

      <input
        type="email"
        id="email"
        placeholder="Email Address"
        required
      >

      <input
        type="password"
        id="password"
        placeholder="Password"
        required
      >

      <button class="btn" type="submit">
        Login / Signup
      </button>

    </form>

    <p id="loginMessage"></p>
  </section>

  <!-- Footer -->
  <footer>
    <p>💜 Made with love by Fanboy Rohan</p>
    <p>© 2026 Fanboy Rohan. All Rights Reserved.</p>
  </footer>

  <script>

    function showMessage() {
      alert("Thank you for supporting Fanboy Rohan! 💜✨");
    }

    function loginUser(event) {

      event.preventDefault();

      const name = document.getElementById("name").value;

      document.getElementById("loginMessage").innerHTML =
        "Welcome, " + name + "! 💜 Your demo login was successful.";

    }

  </script>
