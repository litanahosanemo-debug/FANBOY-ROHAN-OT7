<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Fanboy Rohan 💜 OT7</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #080612;
      color: white;
      line-height: 1.6;
    }

    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(8, 6, 18, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #35294f;
    }

    nav {
      max-width: 1100px;
      margin: auto;
      padding: 18px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      color: #c99cff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 22px;
      font-size: 15px;
      transition: 0.3s;
    }

    nav a:hover {
      color: #c99cff;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 100px 20px 50px;
      background:
        radial-gradient(circle at top, #38205f 0%, #120b22 40%, #080612 75%);
    }

    .hero-content {
      max-width: 850px;
    }

    .hero h1 {
      font-size: clamp(45px, 9vw, 90px);
      margin-bottom: 15px;
      background: linear-gradient(90deg, #ffffff, #c99cff, #8f5cff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero h2 {
      font-size: 25px;
      margin-bottom: 20px;
      color: #ddd;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #bbb;
      font-size: 17px;
    }

    .btn {
      display: inline-block;
      margin-top: 30px;
      padding: 13px 25px;
      border-radius: 30px;
      background: #8f5cff;
      color: white;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
      box-shadow: 0 0 25px rgba(143, 92, 255, 0.4);
    }

    .btn:hover {
      transform: translateY(-4px);
      background: #a978ff;
    }

    section {
      max-width: 1050px;
      margin: auto;
      padding: 90px 25px;
    }

    .section-title {
      text-align: center;
      font-size: 38px;
      margin-bottom: 45px;
      color: #d0a9ff;
    }

    .about {
      text-align: center;
      max-width: 800px;
      margin: auto;
      color: #c8c8c8;
      font-size: 17px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px;
    }

    .card {
      background: #120d20;
      border: 1px solid #35294f;
      border-radius: 18px;
      padding: 30px 20px;
      text-align: center;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: #9c6cff;
      box-shadow: 0 10px 35px rgba(111, 65, 180, 0.25);
    }

    .card .emoji {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .card h3 {
      color: #d7b5ff;
      margin-bottom: 8px;
    }

    .card p {
      color: #aaa;
      font-size: 14px;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .gallery-box {
      height: 230px;
      border-radius: 18px;
      background: linear-gradient(135deg, #291644, #11101b);
      border: 1px solid #392852;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: #aaa;
      font-size: 16px;
      transition: 0.3s;
    }

    .gallery-box:hover {
      transform: scale(1.03);
      border-color: #a778ff;
    }

    .social {
      text-align: center;
    }

    .social a {
      display: inline-block;
      margin: 8px;
      padding: 12px 20px;
      border: 1px solid #493568;
      border-radius: 25px;
      color: white;
      text-decoration: none;
      transition: 0.3s;
    }

    .social a:hover {
      background: #8f5cff;
      border-color: #8f5cff;
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      background: #05040b;
      border-top: 1px solid #292039;
      color: #888;
    }

    footer strong {
      color: #c99cff;
    }

    @media (max-width: 650px) {
      nav {
        flex-direction: column;
        gap: 12px;
      }

      nav a {
        margin: 0 7px;
        font-size: 13px;
      }

      .hero h2 {
        font-size: 20px;
      }

      section {
        padding: 70px 18px;
      }
    }
  </style>
</head>

